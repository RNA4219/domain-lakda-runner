{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/lakda/exploration-target-manifest/v1",
  "title": "Lakda exploration target manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "manifestId", "status", "owner", "charterDigest", "configDigest", "targetRevision", "platform", "adapterId", "executionMode", "target", "safety", "bridgeBinding", "signature"],
  "properties": {
    "schemaVersion": { "const": "lakda/exploration-target-manifest/v1" },
    "manifestId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "status": { "const": "ready" },
    "owner": { "type": "string", "minLength": 1 },
    "charterDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "configDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "targetRevision": { "type": "string", "minLength": 1 },
    "platform": { "enum": ["pc-web", "mobile-web", "windows", "android", "ios"] },
    "adapterId": { "enum": ["playwright", "airtest-poco"] },
    "executionMode": { "const": "real" },
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["identity"],
      "properties": {
        "identity": { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": {
          "kind": { "enum": ["web", "native"] }, "origin": { "type": "string", "pattern": "^https://[^/?#]+$" }, "pathPrefixes": { "type": "array", "items": { "type": "string", "pattern": "^/" } }, "appId": { "type": "string", "minLength": 1 }, "appRevision": { "type": "string", "minLength": 1 }, "deviceAliasDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, "serialDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, "revisionProbe": { "type": "object", "additionalProperties": false, "required": ["kind", "name"], "properties": { "kind": { "enum": ["response-header", "dom-meta"] }, "name": { "type": "string", "minLength": 1 } } }
        }, "allOf": [{ "if": { "properties": { "kind": { "const": "native" } } }, "then": { "required": ["appId", "appRevision", "deviceAliasDigest"] } }] },
        "templateCorpusDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "safety": { "type": "object", "additionalProperties": false, "required": ["allowMutationKinds", "resetProcedureRef", "killSwitchRef"], "properties": { "allowMutationKinds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }, "resetProcedureRef": { "type": "string", "minLength": 1 }, "killSwitchRef": { "type": "string", "minLength": 1 } } },
    "bridgeBinding": { "type": "object", "additionalProperties": false, "required": ["capabilityDigest", "bridgeDigest"], "properties": { "capabilityDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, "bridgeDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } } },
    "artifactAttestorKeyIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "signature": { "type": "object", "additionalProperties": false, "required": ["algorithm", "keyId", "validFrom", "validUntil", "approvalEvidenceRef", "signedPayloadDigest", "valueBase64"], "properties": { "algorithm": { "const": "ed25519" }, "keyId": { "type": "string", "minLength": 1 }, "validFrom": { "type": "string", "minLength": 1 }, "validUntil": { "type": "string", "minLength": 1 }, "approvalEvidenceRef": { "type": "string", "minLength": 1 }, "signedPayloadDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, "valueBase64": { "type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$" } } }
  }
}
