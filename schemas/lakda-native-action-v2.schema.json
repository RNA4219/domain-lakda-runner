{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lakda/native-action/v2",
  "title": "承認期間を制約として保持するnative操作と確認応答",
  "oneOf": [
    {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "operation", "lease", "ordinal", "approvalWindow", "payload"],
      "properties": {
        "schemaVersion": { "const": "lakda/native-action-request/v2" }, "operation": { "const": "execute" },
        "lease": { "$ref": "#/$defs/lease" }, "ordinal": { "$ref": "#/$defs/ordinal" }, "approvalWindow": { "$ref": "#/$defs/window" },
        "payload": { "type": "object", "additionalProperties": false, "required": ["candidate", "context"],
          "properties": { "candidate": { "type": "object" }, "context": { "type": "object" } } }
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "operation", "lease", "ordinal", "approvalWindow", "payload"],
      "properties": {
        "schemaVersion": { "const": "lakda/native-action-request/v2" }, "operation": { "const": "recover" },
        "lease": { "$ref": "#/$defs/lease" }, "ordinal": { "$ref": "#/$defs/ordinal" }, "approvalWindow": { "$ref": "#/$defs/window" },
        "payload": { "type": "object", "additionalProperties": false, "required": ["failure", "context"],
          "properties": { "failure": { "type": "object" }, "context": { "type": "object" } } }
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "operation", "lease", "ordinal", "approvalWindow", "checkedAt", "actionAttempted", "result"],
      "properties": {
        "schemaVersion": { "const": "lakda/native-action-result/v2" }, "operation": { "const": "execute" },
        "lease": { "$ref": "#/$defs/lease" }, "ordinal": { "$ref": "#/$defs/ordinal" }, "approvalWindow": { "$ref": "#/$defs/window" },
        "checkedAt": { "$ref": "#/$defs/time" }, "actionAttempted": { "type": "boolean" },
        "result": { "type": "object", "required": ["executionId", "candidateId", "preFingerprint", "status"] }
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "operation", "lease", "ordinal", "approvalWindow", "checkedAt", "actionAttempted", "result"],
      "properties": {
        "schemaVersion": { "const": "lakda/native-action-result/v2" }, "operation": { "const": "recover" },
        "lease": { "$ref": "#/$defs/lease" }, "ordinal": { "$ref": "#/$defs/ordinal" }, "approvalWindow": { "$ref": "#/$defs/window" },
        "checkedAt": { "$ref": "#/$defs/time" }, "actionAttempted": { "type": "boolean" },
        "result": { "type": "object", "additionalProperties": false, "required": ["recovered", "strategy", "evidenceRefs"],
          "properties": { "recovered": { "type": "boolean" }, "strategy": { "type": "string" }, "targetRef": { "type": "object" }, "evidenceRefs": { "type": "array" } } }
      }
    }
  ],
  "$defs": {
    "ordinal": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "time": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "lease": { "type": "object", "additionalProperties": false, "required": ["observationId", "observationDigest", "connectionId", "challenge"],
      "properties": { "observationId": { "$ref": "#/$defs/uuid" }, "observationDigest": { "$ref": "#/$defs/digest" }, "connectionId": { "$ref": "#/$defs/uuid" }, "challenge": { "$ref": "#/$defs/uuid" } } },
    "window": { "type": "object", "additionalProperties": false, "required": ["targetManifestSha256", "validFrom", "validUntil"],
      "properties": { "targetManifestSha256": { "$ref": "#/$defs/digest" }, "validFrom": { "$ref": "#/$defs/time" }, "validUntil": { "$ref": "#/$defs/time" } } }
  }
}
