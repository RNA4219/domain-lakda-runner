{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/lakda/action-execution/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "attempt", "executions"],
  "properties": {
    "schemaVersion": { "const": "lakda/action-execution/v1" },
    "runId": { "type": "string", "minLength": 1 },
    "attempt": { "type": "integer", "minimum": 1 },
    "executions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "actionId", "kind", "startedAt", "endedAt", "durationMs", "status"],
        "properties": {
          "sequence": { "type": "integer", "minimum": 1 },
          "actionId": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["navigate", "goto", "click", "fill", "check", "select", "press"] },
          "startedAt": { "type": "string", "format": "date-time", "pattern": "Z$" },
          "endedAt": { "type": "string", "format": "date-time", "pattern": "Z$" },
          "durationMs": { "type": "number", "minimum": 0 },
          "status": { "enum": ["completed", "failed"] }
        }
      }
    }
  }
}
