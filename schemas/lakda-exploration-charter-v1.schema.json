{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/lakda/exploration-charter/v1",
  "title": "Lakda autonomous exploration charter v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "charterId", "targetRevision", "platform", "executionMode", "adapter", "persona", "scope", "budget", "stopWhen", "generator", "capture", "templateCorpusVersion", "seed"],
  "properties": {
    "schemaVersion": { "const": "lakda/exploration-charter/v1" },
    "charterId": { "type": "string", "minLength": 1 },
    "targetRevision": { "type": "string", "minLength": 1 },
    "platform": { "enum": ["pc-web", "mobile-web", "windows", "android", "ios"] },
    "executionMode": { "enum": ["fixture", "real", "emulator", "mock"] },
    "targetManifestPath": { "type": "string", "minLength": 1 },
    "trustStorePath": { "type": "string", "minLength": 1 },
    "adapter": {
      "type": "object", "additionalProperties": false, "required": ["id"],
      "properties": {
        "id": { "enum": ["playwright", "airtest-poco"] },
        "endpoint": { "type": "string", "minLength": 1 },
        "initialTarget": { "type": "object", "additionalProperties": false, "required": ["targetId", "kind"], "properties": {
          "targetId": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["page", "frame", "dialog", "device", "surface"] },
          "contextId": { "type": "string" }, "parentTargetId": { "type": "string" },
          "framePath": { "type": "array", "items": { "type": "string" } },
          "origin": { "type": "string" }, "lifecycle": { "enum": ["active", "closed", "lost"] }
        }}
      }
    },
    "baseUrl": { "type": "string", "minLength": 1 },
    "configPath": { "type": "string", "minLength": 1 },
    "persona": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "object", "additionalProperties": false, "required": ["allowHosts"],
      "properties": {
        "allowHosts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "pathPrefixes": { "type": "array", "items": { "type": "string", "pattern": "^/" } },
        "native": { "type": "object", "additionalProperties": false, "required": ["appId", "surfaces", "denyZones"], "properties": {
          "appId": { "type": "string", "minLength": 1 },
          "surfaces": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "denyZones": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"], "properties": { "x": { "type": "number", "minimum": 0, "maximum": 1 }, "y": { "type": "number", "minimum": 0, "maximum": 1 }, "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }, "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }, "surface": { "type": "string", "minLength": 1 } } } }
        } }
      }
    },
    "budget": {
      "type": "object", "additionalProperties": false, "required": ["durationMs", "maxActions", "maxActionsPerMinute"],
      "properties": {
        "durationMs": { "type": "integer", "minimum": 1 }, "maxActions": { "type": "integer", "minimum": 1 }, "maxActionsPerMinute": { "type": "integer", "minimum": 1 }
      }
    },
    "stopWhen": { "type": "object", "minProperties": 1 },
    "generator": {
      "type": "object", "additionalProperties": false, "required": ["strategy", "version"],
      "properties": { "strategy": { "const": "autonomous-uncovered" }, "version": { "const": "autonomous-uncovered/v1" } }
    },
    "capture": {
      "type": "object", "additionalProperties": false, "required": ["video", "screenshot", "sampledFrames"],
      "properties": {
        "video": { "enum": ["retain-on-finding-or-non-pass", "off"] },
        "screenshot": { "const": "finding-non-pass-bookmark" },
        "binaryAttestation": { "type": "object", "additionalProperties": false, "required": ["stagingRoot", "policyDigest"], "properties": {
          "stagingRoot": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "policyDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 300000 }
        } },
        "sampledFrames": { "type": "object", "additionalProperties": false, "required": ["enabled", "intervalMs", "maxFrames", "maxBytes", "source", "stopTimeoutMs"], "properties": { "enabled": { "type": "boolean" }, "intervalMs": { "type": "integer", "minimum": 100 }, "maxFrames": { "type": "integer", "minimum": 1 }, "maxBytes": { "type": "integer", "minimum": 1 }, "source": { "enum": ["operator-bridge", "playwright"] }, "stopTimeoutMs": { "type": "integer", "minimum": 100 } } }
      }
    },
    "templateCorpusVersion": { "type": "string", "minLength": 1 },
    "templateCorpus": { "type": "object", "additionalProperties": false, "required": ["path", "version", "sha256"], "properties": { "path": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } } },
    "seed": { "type": "integer" },
    "outputDir": { "type": "string", "minLength": 1 },
    "profile": { "type": "object", "additionalProperties": false, "properties": {
      "settlePolicy": { "type": "object", "additionalProperties": false, "required": ["policyVersion", "maxWaitMs", "stableWindowMs"], "properties": { "policyVersion": { "type": "string", "minLength": 1 }, "maxWaitMs": { "type": "integer", "minimum": 1 }, "stableWindowMs": { "type": "integer", "minimum": 0 }, "readiness": { "type": "object", "additionalProperties": false, "properties": { "testId": { "type": "string", "minLength": 1 }, "role": { "type": "string", "minLength": 1 }, "name": { "type": "string", "minLength": 1 }, "state": { "enum": ["visible", "hidden"] } } }, "networkQuietExclusions": { "type": "array", "items": { "type": "string", "minLength": 1 } } } },
      "fingerprintPolicy": { "type": "object", "additionalProperties": false, "required": ["algorithmVersion", "canonicalizationVersion"], "properties": { "algorithmVersion": { "type": "string", "minLength": 1 }, "canonicalizationVersion": { "type": "string", "minLength": 1 } } },
      "recovery": { "type": "object", "additionalProperties": false, "required": ["maxBacktracks", "maxAttemptsPerState"], "properties": { "maxBacktracks": { "type": "integer", "minimum": 0 }, "maxAttemptsPerState": { "type": "integer", "minimum": 1 } } }
    } }
  },
  "allOf": [
    { "if": { "properties": { "capture": { "required": ["binaryAttestation"] } } }, "then": { "properties": { "executionMode": { "const": "real" } } } },
    { "if": { "properties": { "executionMode": { "const": "real" } } }, "then": { "required": ["targetManifestPath", "trustStorePath"] } },
    { "if": { "properties": { "platform": { "enum": ["windows", "android", "ios"] } } }, "then": { "required": ["templateCorpus"], "properties": { "scope": { "required": ["native"] } } } }
  ]
}
