{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lakda/native-capture/v1",
  "title": "観測と開始連番に束縛したnative撮影要求・結果",
  "oneOf": [{ "$ref": "#/$defs/request" }, { "$ref": "#/$defs/response" }],
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "time": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "ordinal": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "positive": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "operation": { "enum": ["screenshot", "start", "stop", "discard"] },
    "lease": { "type": "object", "additionalProperties": false,
      "required": ["observationId", "observationDigest", "connectionId", "challenge"],
      "properties": { "observationId": { "$ref": "#/$defs/uuid" }, "observationDigest": { "$ref": "#/$defs/digest" },
        "connectionId": { "$ref": "#/$defs/uuid" }, "challenge": { "$ref": "#/$defs/uuid" } } },
    "window": { "type": "object", "additionalProperties": false,
      "required": ["targetManifestSha256", "validFrom", "validUntil"],
      "properties": { "targetManifestSha256": { "$ref": "#/$defs/digest" }, "validFrom": { "$ref": "#/$defs/time" }, "validUntil": { "$ref": "#/$defs/time" } } },
    "payload": { "type": "object", "additionalProperties": false, "required": ["runId", "stagingDir"],
      "properties": { "runId": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000]+$" },
        "stagingDir": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^\\u0000]+$" },
        "mode": { "enum": ["video", "sampled-frames/v1"] }, "intervalMs": { "$ref": "#/$defs/positive" },
        "maxFrames": { "$ref": "#/$defs/positive" }, "maxBytes": { "$ref": "#/$defs/positive" },
        "stopTimeoutMs": { "type": "integer", "minimum": 1, "maximum": 300000 } } },
    "request": { "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "operation", "lease", "approvalWindow", "ordinal", "captureOrdinal", "payload"],
      "properties": { "schemaVersion": { "const": "lakda/native-capture-request/v1" }, "operation": { "$ref": "#/$defs/operation" },
        "lease": { "$ref": "#/$defs/lease" }, "approvalWindow": { "$ref": "#/$defs/window" },
        "ordinal": { "$ref": "#/$defs/ordinal" }, "captureOrdinal": { "$ref": "#/$defs/ordinal" }, "payload": { "$ref": "#/$defs/payload" } } },
    "result": { "type": "object", "additionalProperties": false, "required": ["accepted", "mode", "artifactRefs"],
      "properties": { "accepted": { "type": "boolean" }, "mode": { "enum": ["screenshot", "video", "sampled-frames/v1"] },
        "artifactRefs": { "type": "array", "items": { "type": "object" } }, "reason": { "type": "string", "maxLength": 256 },
        "stopped": { "type": "boolean" }, "frameCount": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "byteCount": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 } } },
    "response": { "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "operation", "ordinal", "captureOrdinal", "requestSha256", "completedAt", "result"],
      "properties": { "schemaVersion": { "const": "lakda/native-capture-result/v1" }, "operation": { "$ref": "#/$defs/operation" },
        "ordinal": { "$ref": "#/$defs/ordinal" }, "captureOrdinal": { "$ref": "#/$defs/ordinal" }, "requestSha256": { "$ref": "#/$defs/digest" },
        "completedAt": { "$ref": "#/$defs/time" }, "result": { "$ref": "#/$defs/result" } } }
  }
}
