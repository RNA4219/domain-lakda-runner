{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/lakda/exploration-report/v1",
  "title": "Lakda exploration report v1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "sessionId", "status", "charterDigest", "platform", "lane", "targetRevision", "coverage", "findings", "blockers", "capture", "residualRisk", "goNoGo"],
  "properties": {
    "schemaVersion": { "const": "lakda/exploration-report/v1" }, "sessionId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "running", "paused", "completed", "aborted", "pending_external"] }, "charterDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "platform": { "enum": ["pc-web", "mobile-web", "windows", "android", "ios"] }, "lane": { "type": "string", "minLength": 1 }, "targetRevision": { "type": "string", "minLength": 1 }, "executionMode": { "enum": ["fixture", "real", "emulator", "mock"] },
    "coverage": { "type": "object", "additionalProperties": false, "required": ["actions", "states", "transitions", "unexplored"], "properties": { "actions": { "type": "number" }, "states": { "type": "number" }, "transitions": { "type": "number" }, "unexplored": { "type": "array", "items": { "type": "string" } }, "timeline": { "type": "array", "items": { "type": "object" } } } },
    "findings": { "type": "array", "items": { "$ref": "https://local.invalid/lakda/exploration-finding/v1" } }, "blockers": { "type": "array", "items": { "type": "string" } },
    "capture": { "type": "object", "additionalProperties": false, "required": ["screenshots", "videos", "sampledFrames", "failures"], "properties": { "screenshots": { "type": "integer", "minimum": 0 }, "videos": { "type": "integer", "minimum": 0 }, "sampledFrames": { "type": "integer", "minimum": 0 }, "failures": { "type": "array", "items": { "type": "string" } } } },
    "residualRisk": { "type": "array", "items": { "type": "string" } }, "goNoGo": { "const": "external-qeg-required" }, "runIds": { "type": "array", "items": { "type": "string" } },
    "sessionStatus": { "enum": ["draft", "running", "paused", "completed", "aborted"] }, "technicalOutcome": { "enum": ["passed", "failed", "partial", "error"] }, "terminationReason": { "type": "string", "minLength": 1 }, "acceptanceStatus": { "enum": ["fixture_only", "pending_external", "eligible", "rejected"] }
  }
}
