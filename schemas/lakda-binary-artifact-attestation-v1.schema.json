{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/lakda/binary-artifact-attestation/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourcePath", "sourceSha256", "sourceSize", "decision", "redactionRuleVersion", "secretScan", "piiScan"],
  "properties": {
    "schemaVersion": { "const": "lakda/binary-artifact-attestation/v1" },
    "sourcePath": { "type": "string", "minLength": 1 },
    "sourceSha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "sourceSize": { "type": "integer", "minimum": 0 },
    "outputPath": { "type": "string", "minLength": 1 },
    "outputSha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "outputSize": { "type": "integer", "minimum": 0 },
    "decision": { "enum": ["no-sensitive-content", "sanitized"] },
    "redactionRuleVersion": { "type": "string", "minLength": 1 },
    "secretScan": { "const": "pass" },
    "piiScan": { "const": "pass" },
    "tool": { "type": "object", "additionalProperties": false, "required": ["name", "version", "policyDigest"], "properties": { "name": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 }, "policyDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } } },
    "signature": { "type": "object", "additionalProperties": false, "required": ["algorithm", "keyId", "signedPayloadDigest", "valueBase64"], "properties": { "algorithm": { "const": "ed25519" }, "keyId": { "type": "string", "minLength": 1 }, "signedPayloadDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, "valueBase64": { "type": "string", "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$" } } }
  },
  "allOf": [
    {
      "if": { "properties": { "decision": { "const": "no-sensitive-content" } } },
      "then": {
        "not": { "anyOf": [{ "required": ["outputPath"] }, { "required": ["outputSha256"] }, { "required": ["outputSize"] }] }
      }
    },
    {
      "if": { "properties": { "decision": { "const": "sanitized" } } },
      "then": { "required": ["outputPath", "outputSha256", "outputSize"] }
    },
    { "if": { "required": ["outputPath"] }, "then": { "required": ["outputSha256", "outputSize"] } },
    { "if": { "required": ["outputSha256"] }, "then": { "required": ["outputPath", "outputSize"] } },
    { "if": { "required": ["outputSize"] }, "then": { "required": ["outputPath", "outputSha256"] } }
  ]
}
