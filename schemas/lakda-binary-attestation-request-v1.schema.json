{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/lakda/binary-attestation-request/v1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "runId", "targetManifestSha256", "sourcePath", "sourceSha256", "sourceSize", "outputPath", "mediaType", "policyDigest", "nonce", "createdAt", "expiresAt"],
  "properties": {
    "schemaVersion": { "const": "lakda/binary-attestation-request/v1" },
    "requestId": { "$ref": "#/$defs/uuid" },
    "runId": { "$ref": "#/$defs/id" },
    "sessionId": { "$ref": "#/$defs/id" },
    "targetManifestSha256": { "$ref": "#/$defs/digest" },
    "sourcePath": { "$ref": "#/$defs/path" },
    "sourceSha256": { "$ref": "#/$defs/digest" },
    "sourceSize": { "$ref": "#/$defs/size" },
    "outputPath": { "$ref": "#/$defs/path" },
    "mediaType": { "enum": ["image/png", "image/jpeg", "video/webm", "video/mp4", "application/zip"] },
    "policyDigest": { "$ref": "#/$defs/digest" },
    "nonce": { "$ref": "#/$defs/uuid" },
    "createdAt": { "$ref": "#/$defs/time" },
    "expiresAt": { "$ref": "#/$defs/time" }
  },
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "path": { "type": "string", "minLength": 1, "maxLength": 512 },
    "size": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "time": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" }
  }
}
