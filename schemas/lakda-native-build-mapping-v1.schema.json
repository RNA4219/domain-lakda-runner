{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lakda/native-build-mapping/v1",
  "title": "実観測buildと承認revisionの対応",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mappingId",
    "platform",
    "provider",
    "appId",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "const": "lakda/native-build-mapping/v1"
    },
    "mappingId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "platform": {
      "enum": [
        "windows",
        "android",
        "ios"
      ]
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/+:-]*$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/+:-]*$"
        }
      }
    },
    "appId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f/\\\\]+$"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "observedBuild",
          "targetRevision"
        ],
        "properties": {
          "observedBuild": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001f\\u007f/\\\\]+$"
          },
          "targetRevision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001f\\u007f/\\\\]+$"
          }
        }
      }
    }
  }
}
